{
  "name": "mindful-stage",
  "displayName": "Mindful Stage",
  "description": "Keyboard-driven incremental staging for VS Code - jump between hunks and files, staging as you go.",
  "version": "2.0.0",
  "publisher": "diminishedprime",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm build"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Mindful Stage",
      "properties": {
        "mindfulStage.log": {
          "type": "boolean",
          "default": false,
          "description": "Write a diagnostic log of every navigation command to mindful-stage.log in the extension's global storage directory."
        }
      }
    },
    "commands": [
      {
        "command": "mindfulStage.nextUnstaged",
        "title": "Mindful Stage: Jump to Next Unstaged File"
      },
      {
        "command": "mindfulStage.prevUnstaged",
        "title": "Mindful Stage: Jump to Previous Unstaged File"
      },
      {
        "command": "mindfulStage.startTracking",
        "title": "Mindful Stage: Start Tracking File (stage first line)"
      },
      {
        "command": "mindfulStage.nextUnstagedHunk",
        "title": "Mindful Stage: Jump to Next Unstaged Hunk"
      },
      {
        "command": "mindfulStage.prevUnstagedHunk",
        "title": "Mindful Stage: Jump to Previous Unstaged Hunk"
      },
      {
        "command": "mindfulStage.nextStaged",
        "title": "Mindful Stage: Jump to Next Staged File"
      },
      {
        "command": "mindfulStage.prevStaged",
        "title": "Mindful Stage: Jump to Previous Staged File"
      },
      {
        "command": "mindfulStage.nextStagedHunk",
        "title": "Mindful Stage: Jump to Next Staged Hunk"
      },
      {
        "command": "mindfulStage.prevStagedHunk",
        "title": "Mindful Stage: Jump to Previous Staged Hunk"
      },
      {
        "command": "mindfulStage.nextStagedRepo",
        "title": "Mindful Stage: Jump to Next Repo With Staged Changes"
      },
      {
        "command": "mindfulStage.prevStagedRepo",
        "title": "Mindful Stage: Jump to Previous Repo With Staged Changes"
      },
      {
        "command": "mindfulStage.repeatLast",
        "title": "Mindful Stage: Repeat Last Nav"
      },
      {
        "command": "mindfulStage.stageHunkAtCursor",
        "title": "Mindful Stage: Stage Unstaged Hunk at Cursor"
      },
      {
        "command": "mindfulStage.pickRepo",
        "title": "Mindful Stage: Pick a Repo With Outstanding Work"
      }
    ],
    "icons": {
      "mindful-stage-clean": {
        "description": "Mindful Stage clean icon",
        "default": {
          "fontPath": "assets/mindful-stage.woff",
          "fontCharacter": "\\F105"
        }
      },
      "mindful-stage-missing-upstream": {
        "description": "Mindful Stage missing-upstream icon",
        "default": {
          "fontPath": "assets/mindful-stage.woff",
          "fontCharacter": "\\F106"
        }
      },
      "mindful-stage-ms": {
        "description": "Mindful Stage ms icon",
        "default": {
          "fontPath": "assets/mindful-stage.woff",
          "fontCharacter": "\\F101"
        }
      },
      "mindful-stage-ready": {
        "description": "Mindful Stage ready icon",
        "default": {
          "fontPath": "assets/mindful-stage.woff",
          "fontCharacter": "\\F104"
        }
      },
      "mindful-stage-unpushed": {
        "description": "Mindful Stage unpushed icon",
        "default": {
          "fontPath": "assets/mindful-stage.woff",
          "fontCharacter": "\\F102"
        }
      }
    }
  },
  "devDependencies": {
    "@parcel/watcher": "^2.6.0",
    "@types/node": "^25.9.6",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "fantasticon": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@rushstack/lookup-by-path": "^0.10.15",
    "fast-glob": "^3.3.3",
    "gitignore-fs": "^2.2.3",
    "parse-diff": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "simple-git": "^3.36.0",
    "sorted-btree": "^2.1.0",
    "tsyringe": "^4.10.0"
  }
}
